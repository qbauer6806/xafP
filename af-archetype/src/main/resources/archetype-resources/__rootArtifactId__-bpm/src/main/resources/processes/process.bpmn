      <endEvent id="endevent1" name="End"></endEvent>
      <serviceTask id="servicetask8" name="Envoi d'un email à l'agent affecté (template &quot;par agent&quot;)" activiti:delegateExpression="${d}{gouvBPMEnvoiEmailAgentAffecteDelegate}">
