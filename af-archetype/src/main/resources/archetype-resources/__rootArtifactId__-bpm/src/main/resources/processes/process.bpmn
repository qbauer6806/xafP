      </sequenceFlow>
      <sequenceFlow id="flow84" sourceRef="exclusivegateway10" targetRef="endevent1">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_DEMANDE_CANAL.equals('COURRIER') || MC_DEMANDE_CANAL.equals('GUICHET_PHYSIQUE')}]]></conditionExpression>
      </sequenceFlow>
      <serviceTask id="servicetask5" name="Génération du courrier" activiti:delegateExpression="${d}{gouvBPMPdfDelegate}"></serviceTask>
      <sequenceFlow id="flow81" sourceRef="servicetask5" targetRef="endevent1"></sequenceFlow>
      <serviceTask id="creationDICTask" name="Création d'une demande d'informations complémentaires" activiti:delegateExpression="${d}{gouvBPMDemandeInfoComplDelegate}"></serviceTask>
      <sequenceFlow id="flow36" sourceRef="creationDICTask" targetRef="chgtEtatServiceTask3"></sequenceFlow>
      <serviceTask id="envoiMailUsagerServiceTask2" name="Envoi d'un email à l'usager" activiti:delegateExpression="${d}{gouvBPMEnvoiEmailUsagerDelegate}">
