      </serviceTask>
      <sequenceFlow id="flow112" sourceRef="servicetask9" targetRef="chgtEtatServiceTask1"></sequenceFlow>
      <sequenceFlow id="flow113" sourceRef="depotICTask" targetRef="servicetask9">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_TARGETSTATE_ORIGINATOR_USAGER != null}]]></conditionExpression>
      </sequenceFlow>
      <userTask id="prendreEnChargeTask" name="Prendre en charge" activiti:candidateGroups="TRAITEMENT"></userTask>
      <sequenceFlow id="flow93" sourceRef="prendreEnChargeTask" targetRef="chgtEtatServiceTask1"></sequenceFlow>
      <exclusiveGateway id="exclusivegateway13" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow120" sourceRef="chgtEtatServiceTask1" targetRef="exclusivegateway13"></sequenceFlow>
      <sequenceFlow id="flow121" sourceRef="exclusivegateway13" targetRef="traiterDemandeTask"></sequenceFlow>
      <sequenceFlow id="flow123" sourceRef="validationComptableTask" targetRef="DeleteEnAttenteValidationDataRefus">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_TARGETSTATE.equals('REFUSEE')}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow124" sourceRef="exclusivegateway2" targetRef="chgtEtatServiceTask6">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_TARGETSTATE.equals('REFUSEE')}]]></conditionExpression>
