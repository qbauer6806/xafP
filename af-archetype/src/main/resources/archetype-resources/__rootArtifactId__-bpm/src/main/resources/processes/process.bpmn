      <serviceTask id="servicetask1" name="Génération du courrier" activiti:delegateExpression="${d}{gouvBPMPdfDelegate}"></serviceTask>
      <sequenceFlow id="flow71" sourceRef="servicetask1" targetRef="exclusivegateway12"></sequenceFlow>
      <serviceTask id="servicetask4" name="Envoi d'un email à l'usager" activiti:delegateExpression="${d}{gouvBPMEnvoiEmailUsagerDelegate}">
