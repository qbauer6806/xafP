      <sequenceFlow id="flow82" sourceRef="chgtEtatServiceTask7" targetRef="exclusivegateway10"></sequenceFlow>
      <exclusiveGateway id="exclusivegateway7" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow69" sourceRef="exclusivegateway7" targetRef="envoiMailUsagerServiceTask2">
