{
	"settings": {
		"analysis": {
			"filter": {
				"french_elision": {
					"type": "elision",
					"articles_case": true,
					"articles": [
						"l",
						"m",
						"t",
						"qu",
						"n",
						"s",
						"j",
						"d",
						"c",
						"jusqu",
						"quoiqu",
						"lorsqu",
						"puisqu"
					]
				},
				"french_stop": {
					"type": "stop",
					"stopwords": "_french_"
				},
				"french_keywords": {
					"type": "keyword_marker",
					"keywords": [
						"Exemple"
					]
				},
				"french_stemmer": {
					"type": "stemmer",
					"language": "french"
				},
				"ngram_filter": {
					"type": "ngram",
					"min_gram": 1,
					"max_gram": 25
				}
			},
			"char_filter": {
				"identifiant_char_filter": {
					"type": "mapping",
					"mappings": [
						"- => _"
					]
				}
			},
			"analyzer": {
				"ngram": {
					"tokenizer": "standard",
					"filter": [
						"lowercase",
						"asciifolding",
						"ngram_filter"
					]
				},
				"identifiant_ngram_index": {
					"tokenizer": "standard",
					"char_filter": [
						"identifiant_char_filter"
					],
					"filter": [
						"lowercase",
						"ngram_filter"
					]
				},
				"identifiant_ngram_search": {
					"tokenizer": "keyword",
					"char_filter": [
						"identifiant_char_filter"
					],
					"filter": [
						"lowercase"
					]
				},
				"keyword_lowercase": {
					"tokenizer": "keyword",
					"filter": [
						"lowercase",
						"asciifolding"
					]
				},
				"default": {
					"tokenizer": "standard",
					"filter": [
						"french_elision",
						"lowercase",
						"french_stop",
						"french_keywords",
						"french_stemmer",
						"ngram_filter"
					]
				},
				"default_search": {
					"tokenizer": "standard",
					"filter": [
						"french_elision",
						"lowercase",
						"french_stop",
						"french_keywords",
						"french_stemmer"
					]
				}
			}
		}
