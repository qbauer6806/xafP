<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0  http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>${artifactIdLower}-front</artifactId>
	<groupId>mc.gouv.${artifactIdLower}</groupId>
	<version>${version}</version>
	<packaging>war</packaging>
	<build>
		<finalName>${tsFrontUrl}</finalName>
		<resources>
            		<resource>
                		<directory>src/main/resources</directory>
                		<filtering>true</filtering>
            		</resource>
        	</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.2.0</version>
				<configuration>
					<webResources>
						<resource>
							<filtering>true</filtering>
							<directory>src/main/webapp</directory>
							<includes>
								<include>*.html</include>
							</includes>
						</resource>
					</webResources>
				</configuration>
			</plugin>
			<plugin><groupId>org.eclipse.jetty</groupId><artifactId>jetty-maven-plugin</artifactId><configuration><httpConnector><port>${tsFrontPort}</port></httpConnector><stopKey>STOPITNOW</stopKey><stopPort>20799</stopPort><webApp><contextPath>/${tsFrontUrl}</contextPath></webApp><systemProperties><systemProperty><name>MC_GOUV_PROPERTIES_FILE</name><value>file:///d:/java_dev_env/propertiesJETTY/mc.gouv.properties</value></systemProperty><systemProperty><name>org.slf4j.simpleLogger.defaultLogLevel</name><value>debug</value></systemProperty><!-- Fix problem with slf4j being in both the jetty and webapp classloader --><systemProperty><name>org.eclipse.jetty.server.webapp.parentLoaderPriority</name><value>true</value></systemProperty></systemProperties></configuration><dependencies><dependency><groupId>mc.gouv.tools_dev</groupId><artifactId>dev_config</artifactId><version>1.0.1</version></dependency><dependency><groupId>mc.gouv.tools_jar</groupId><artifactId>tools_jar</artifactId><version>3.0.2</version></dependency><!-- Use simple logger in dev env --><dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId><version>1.7.5</version></dependency><!-- For sanity Redirect log4j to slf4j by replacing log4j jar --><dependency><groupId>org.slf4j</groupId><artifactId>log4j-over-slf4j</artifactId><version>1.7.5</version></dependency><dependency><groupId>org.slf4j</groupId><artifactId>jul-to-slf4j</artifactId><version>1.7.5</version></dependency></dependencies></plugin>

    		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<version>3.1.0</version>
			<scope>provided</scope>
		</dependency>
		
		<dependency><groupId>mc.gouv.tools_monitor</groupId><artifactId>tools_monitor</artifactId><version>1.0.8</version><scope>compile</scope><type>jar</type></dependency>
<dependency><groupId>mc.gouv.tools_www</groupId><artifactId>tools_www</artifactId><version>1.0.3</version><scope>compile</scope><type>jar</type></dependency>
<dependency><groupId>mc.gouv.tools_jar</groupId><artifactId>tools_jar</artifactId><version>3.0.2</version><scope>compile</scope></dependency>
<!-- dépendances propertiesProxy -->
<dependency>
<groupId>com.googlecode.json-simple</groupId>
<artifactId>json-simple</artifactId>
<version>1.1.1</version>
</dependency>
<!-- dépendances loginHome --><dependency>
<groupId>org.apache.httpcomponents</groupId>
<artifactId>httpclient</artifactId>
<version>4.5.1</version>
</dependency>
<!-- dépendances AFS -->
<dependency>
<groupId>mc.gouv.af</groupId>
<artifactId>af-servlet</artifactId>
<version>5.0.1-SNAPSHOT</version>
<classifier>classes</classifier>
</dependency>

	</dependencies>
	<parent><groupId>mc.gouv.pom</groupId><artifactId>super-pom-war-frontoffice</artifactId><version>1.44.20</version><relativePath /></parent>

<properties><jettyVersion>9.4.12.v20180830</jettyVersion></properties>

</project>
