    "extraXml": "<parent><groupId>mc.gouv.pom</groupId><artifactId>super-pom-war-frontoffice</artifactId><version>1.44.20</version><relativePath /></parent>\n\n<properties><jettyVersion>9.4.12.v20180830</jettyVersion></properties>\n",
    "finalName": "generique-tshi",
