#set( $symbol_pound = '#' )
#set( $symbol_dollar = '$' )
#set( $symbol_escape = '\' )
<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.0"
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
	http://java.sun.com/xml/ns/javaee
	http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
	metadata-complete="true">
	<display-name>${tsFrontUrl}</display-name>
	<welcome-file-list>
		<welcome-file>index.html</welcome-file>
	</welcome-file-list>
	
	<mime-mapping>
		<extension>ico</extension>
		<mime-type>image/x-icon</mime-type>
	</mime-mapping>
	
	<mime-mapping>
		<extension>woff</extension>
		<mime-type>application/x-font-woff</mime-type>
	</mime-mapping>
	
	<mime-mapping>
		<extension>eot</extension>
		<mime-type>application/vnd.ms-fontobject</mime-type>
	</mime-mapping>
	
	<mime-mapping>
		<extension>ttf</extension>
		<mime-type>application/x-font-ttf</mime-type>
	</mime-mapping>
	
	<mime-mapping>
		<extension>svg</extension>
		<mime-type>image/svg+xml</mime-type>
	</mime-mapping>
	
	<filter><filter-name>MDCLogFilter</filter-name><filter-class>mc.gouv.tools.monitor.filters.MDCLogFilter</filter-class></filter>
<filter-mapping><filter-name>MDCLogFilter</filter-name><url-pattern>/*</url-pattern></filter-mapping>
<servlet><servlet-name>MonitorServlet</servlet-name><servlet-class>mc.gouv.tools.monitor.servlets.MonitorServlet</servlet-class></servlet>
<servlet-mapping><servlet-name>MonitorServlet</servlet-name><url-pattern>/monitor/*</url-pattern></servlet-mapping>
<listener><listener-class>mc.gouv.tools.monitor.servlets.SessionCounter</listener-class></listener>
<servlet><servlet-name>PropertiesProxy</servlet-name><servlet-class>mc.gouv.appfactory.PropertiesProxy</servlet-class></servlet><servlet-mapping><servlet-name>PropertiesProxy</servlet-name><url-pattern>/propertiesproxy/*</url-pattern></servlet-mapping><servlet><servlet-name>LoginHome</servlet-name><servlet-class>mc.gouv.appfactory.LoginHome</servlet-class></servlet><servlet-mapping><servlet-name>LoginHome</servlet-name><url-pattern>/home.xhtml</url-pattern></servlet-mapping><servlet><servlet-name>LoginContact</servlet-name><servlet-class>mc.gouv.appfactory.LoginContact</servlet-class></servlet><servlet-mapping><servlet-name>LoginContact</servlet-name><url-pattern>/public/*</url-pattern></servlet-mapping><servlet><servlet-name>ErrorHandler</servlet-name><servlet-class>mc.gouv.appfactory.ErrorHandler</servlet-class></servlet><servlet-mapping><servlet-name>ErrorHandler</servlet-name><url-pattern>/error</url-pattern></servlet-mapping><error-page><location>/error</location></error-page><error-page><exception-type>mc.gouv.xapi.error.exception.WebException</exception-type><location>/error</location></error-page><servlet><servlet-name>AccessesServlet</servlet-name><servlet-class>mc.gouv.af.servlet.AccessesServlet</servlet-class></servlet><servlet-mapping><servlet-name>AccessesServlet</servlet-name><url-pattern>/accesses</url-pattern></servlet-mapping><servlet><servlet-name>SessionsServlet</servlet-name><servlet-class>mc.gouv.af.servlet.SessionsServlet</servlet-class></servlet><servlet-mapping><servlet-name>SessionsServlet</servlet-name><url-pattern>/sessions</url-pattern></servlet-mapping><servlet><servlet-name>DemandesServlet</servlet-name><servlet-class>mc.gouv.af.servlet.DemandesServlet</servlet-class></servlet><servlet-mapping><servlet-name>DemandesServlet</servlet-name><url-pattern>/demandes/*</url-pattern></servlet-mapping><servlet><servlet-name>LoginServlet</servlet-name><servlet-class>mc.gouv.af.servlet.LoginServlet</servlet-class></servlet><servlet-mapping><servlet-name>LoginServlet</servlet-name><url-pattern>/login</url-pattern></servlet-mapping><servlet><servlet-name>PaysServlet</servlet-name><servlet-class>mc.gouv.af.servlet.PaysServlet</servlet-class></servlet><servlet-mapping><servlet-name>PaysServlet</servlet-name><url-pattern>/pays/*</url-pattern></servlet-mapping><servlet><servlet-name>FileDownloadServlet</servlet-name><servlet-class>mc.gouv.af.servlet.FileDownloadServlet</servlet-class></servlet><servlet-mapping><servlet-name>FileDownloadServlet</servlet-name><url-pattern>/filedownload/*</url-pattern></servlet-mapping><servlet><servlet-name>FileUploadServlet</servlet-name><servlet-class>mc.gouv.af.servlet.FileUploadServlet</servlet-class></servlet><servlet-mapping><servlet-name>FileUploadServlet</servlet-name><url-pattern>/fileupload/*</url-pattern></servlet-mapping><servlet><servlet-name>MotifsServlet</servlet-name><servlet-class>mc.gouv.af.servlet.MotifsServlet</servlet-class></servlet><servlet-mapping><servlet-name>MotifsServlet</servlet-name><url-pattern>/motifs</url-pattern></servlet-mapping><servlet><servlet-name>AnnulationServlet</servlet-name><servlet-class>mc.gouv.af.servlet.AnnulationServlet</servlet-class></servlet><servlet-mapping><servlet-name>AnnulationServlet</servlet-name><url-pattern>/annulation/*</url-pattern></servlet-mapping><servlet><servlet-name>RedirectToBackOfficeServlet</servlet-name><servlet-class>mc.gouv.af.servlet.RedirectToBackOfficeServlet</servlet-class></servlet><servlet-mapping><servlet-name>RedirectToBackOfficeServlet</servlet-name><url-pattern>/redirect-to-backoffice</url-pattern></servlet-mapping><servlet><servlet-name>AssociationDemandeCourrierServlet</servlet-name><servlet-class>mc.gouv.af.servlet.AssociationDemandeCourrierServlet</servlet-class></servlet><servlet-mapping><servlet-name>AssociationDemandeCourrierServlet</servlet-name><url-pattern>/associerDemandeCourrier/*</url-pattern></servlet-mapping><servlet><servlet-name>VerificationIbanServlet</servlet-name><servlet-class>mc.gouv.af.servlet.VerificationIbanServlet</servlet-class></servlet><servlet-mapping><servlet-name>VerificationIbanServlet</servlet-name><url-pattern>/verification-iban</url-pattern></servlet-mapping><context-param><param-name>DemarcheID</param-name><param-value>${artifactIdUpper}</param-value></context-param><context-param><param-name>ContainerID</param-name><param-value>ROOT</param-value></context-param>
</web-app>
