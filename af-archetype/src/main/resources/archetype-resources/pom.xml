    </parent>
    
    <properties>
        <logon-apiclient.version>5.1.0</logon-apiclient.version>
        <logon.version>5.1.0</logon.version>
        <servicerest_client.version>2.2.15</servicerest_client.version>
        <af.version>5.0.1-SNAPSHOT</af.version>
