<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>1.3.2.RELEASE</version>
        <relativePath />
    </parent>

    <groupId>mc.gouv.af</groupId>
    <artifactId>af-back</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <properties>
        <activiti.version>5.21.0</activiti.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.activiti</groupId>
            <artifactId>activiti-spring-boot-starter-basic</artifactId>
            <version>${activiti.version}</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.activiti</groupId>
            <artifactId>activiti-spring-boot-starter-rest-api</artifactId>
            <!--<artifactId>spring-boot-starter-rest-api</artifactId> -->
            <version>${activiti.version}</version>
        </dependency>

        <dependency>
            <groupId>mc.gouv.tools_jar</groupId>
            <artifactId>tools_jar</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- <dependency> <groupId>mc.gouv.logon</groupId> <artifactId>logon_service</artifactId> 
            <version>4.0.37-SNAPSHOT</version> </dependency> <dependency> <groupId>mc.gouv.tools_sql2</groupId> 
            <artifactId>tools_sql2_www</artifactId> <version>2.0.5</version> </dependency> -->

        <dependency>
            <groupId>mc.gouv.logon</groupId>
            <artifactId>logon-apiclient</artifactId>
            <version>4.0.37-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>

        <dependency>
            <groupId>db2</groupId>
            <artifactId>db2jcc4</artifactId>
            <version>9.7</version>
        </dependency>
    </dependencies>

    <scm>
        <developerConnection>${svn.connection}/${project.artifactId}/trunk</developerConnection>
        <connection>${svn.connection}/${project.artifactId}/trunk</connection>
        <url>${svn.url}/${project.artifactId}/trunk</url>
    </scm>
</project>
