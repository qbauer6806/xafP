<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
	http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>appfactory-servlet</artifactId>
	<groupId>mc.gouv.tp</groupId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>war</packaging>
	<build>
		<finalName>appfactory-servlet</finalName>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>true</filtering>
			</resource>
		</resources>
		<plugins>

			<plugin>
				<groupId>org.eclipse.jetty</groupId>
				<artifactId>jetty-maven-plugin</artifactId>
				<configuration>
					<httpConnector>
						<port>20041</port>
					</httpConnector>
					<stopKey>STOPITNOW</stopKey>
					<stopPort>20049</stopPort>
					<webApp>
						<contextPath>/appfactoryservlet</contextPath>
					</webApp>
					<systemProperties>
						<systemProperty>
							<name>MC_GOUV_PROPERTIES_FILE</name>
							<value>file:///d:/java_dev_env/propertiesJETTY/mc.gouv.properties</value>
						</systemProperty>
						<systemProperty>
							<name>org.slf4j.simpleLogger.defaultLogLevel</name>
							<value>debug</value>
						</systemProperty><!-- Fix problem with slf4j being in both the jetty 
							and webapp classloader -->
						<systemProperty>
							<name>org.eclipse.jetty.server.webapp.parentLoaderPriority</name>
							<value>true</value>
						</systemProperty>
					</systemProperties>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>mc.gouv.tools_dev</groupId>
						<artifactId>dev_config</artifactId>
						<version>1.0.1</version>
					</dependency>
					<dependency>
						<groupId>mc.gouv.tools_jar</groupId>
						<artifactId>tools_jar</artifactId>
						<version>3.0.2</version>
					</dependency><!-- Use simple logger in dev env -->
					<dependency>
						<groupId>org.slf4j</groupId>
						<artifactId>slf4j-simple</artifactId>
						<version>1.7.5</version>
					</dependency><!-- For sanity Redirect log4j to slf4j by replacing log4j 
						jar -->
					<dependency>
						<groupId>org.slf4j</groupId>
						<artifactId>log4j-over-slf4j</artifactId>
						<version>1.7.5</version>
					</dependency>
					<dependency>
						<groupId>org.slf4j</groupId>
						<artifactId>jul-to-slf4j</artifactId>
						<version>1.7.5</version>
					</dependency>
				</dependencies>
			</plugin>

		</plugins>
	</build>
	<dependencies>
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<version>3.1.0</version>
			<scope>provided</scope>
		</dependency>
		<!-- dépendances restproxy.java -->
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>18.0</version>
		</dependency>
		<dependency>
			<groupId>com.google.code.gson</groupId>
			<artifactId>gson</artifactId>
			<version>2.3.1</version>
		</dependency>
		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>fluent-hc</artifactId>
			<version>4.5.1</version>
		</dependency>

		<dependency>
			<groupId>mc.gouv.tools_monitor</groupId>
			<artifactId>tools_monitor</artifactId>
			<version>1.0.8</version>
			<scope>compile</scope>
			<type>jar</type>
		</dependency>
		<dependency>
			<groupId>mc.gouv.tools_www</groupId>
			<artifactId>tools_www</artifactId>
			<version>1.0.3</version>
			<scope>compile</scope>
			<type>jar</type>
		</dependency>
		<dependency>
			<groupId>mc.gouv.tools_jar</groupId>
			<artifactId>tools_jar</artifactId>
			<version>3.0.2</version>
			<scope>compile</scope>
		</dependency>
		<!-- dépendances mailProxy Internal -->
		<dependency>
			<groupId>com.lyncode</groupId>
			<artifactId>jtwig-core</artifactId>
			<version>3.1.1</version>
		</dependency>
		<dependency>
			<groupId>com.googlecode.json-simple</groupId>
			<artifactId>json-simple</artifactId>
			<version>1.1.1</version>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-email</artifactId>
			<version>1.4</version>
		</dependency>
		<!-- dépendances fileHelper filesystem -->
		<dependency>
			<groupId>commons-fileupload</groupId>
			<artifactId>commons-fileupload</artifactId>
			<version>1.3.1</version>
		</dependency>
		<!-- dépendances serviceRestProxy -->
		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
			<version>1.10</version>
		</dependency>
		<!-- dépendances loginHome -->
		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpclient</artifactId>
			<version>4.5.1</version>
		</dependency>
	</dependencies>
	<parent>
		<groupId>mc.gouv.pom</groupId>
		<artifactId>super-pom-war-frontoffice</artifactId>
		<version>1.44.20</version>
		<relativePath />
	</parent>

</project>
