<?xml version="1.0" encoding="UTF-8"?>
<archetype-descriptor xsi:schemaLocation="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0 http://maven.apache.org/xsd/archetype-descriptor-1.1.0.xsd" name="detsala"
    xmlns="https://maven.apache.org/plugins/maven-archetype-plugin/archetype-descriptor/1.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <requiredProperties>
    <requiredProperty key="artifactIdUpper">
      <defaultValue>DERRDOM</defaultValue>
    </requiredProperty>
    <requiredProperty key="artifactIdCamelCase">
      <defaultValue>Derrdom</defaultValue>
    </requiredProperty>
    <requiredProperty key="artifactIdLower">
      <defaultValue>derrdom</defaultValue>
    </requiredProperty>
    <requiredProperty key="tsFrontUrl">
      <defaultValue>derogation-repos-dominical</defaultValue>
    </requiredProperty>
    <requiredProperty key="tsFullName">
      <defaultValue>Détacher un salarié à Monaco pour une durée inférieure à 3 mois</defaultValue>
    </requiredProperty>
    <requiredProperty key="tsBackPort">
      <defaultValue>10900</defaultValue>
    </requiredProperty>
    <requiredProperty key="tsFrontPort">
      <defaultValue>20900</defaultValue>
    </requiredProperty>
    <requiredProperty key="tsApiPort">
      <defaultValue>30900</defaultValue>
    </requiredProperty>
    <requiredProperty key="tsIdentifiantDemande">
      <defaultValue>DRD</defaultValue>
    </requiredProperty>
  </requiredProperties>
  <fileSets>
    <fileSet filtered="true" encoding="UTF-8">
      <directory>__rootArtifactId__-properties</directory>
      <includes>
        <include>**/*.properties</include>
      </includes>
    </fileSet>
    <fileSet filtered="true" encoding="UTF-8">
      <directory>__rootArtifactId__-db</directory>
      <includes>
        <include>**/*.sql</include>
      </includes>
    </fileSet>
    <fileSet encoding="UTF-8">
      <directory>__rootArtifactId__-es</directory>
      <includes>
        <include>**/*.json</include>
      </includes>
    </fileSet>
    <fileSet encoding="UTF-8">
      <directory></directory>
      <includes>
        <include>.gitignore</include>
      </includes>
    </fileSet>
  </fileSets>
  <modules>
    <module id="${rootArtifactId}-bpm" dir="__rootArtifactId__-bpm" name="${rootArtifactId}-bpm">
      <fileSets>
        <fileSet filtered="true" encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**/*.bpmn</include>
          </includes>
        </fileSet>
        <fileSet encoding="UTF-8">
          <directory>.settings</directory>
          <includes>
            <include>**/*.prefs</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
          <directory></directory>
          <includes>
            <include>.classpath</include>
            <include>.project</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
    <module id="${rootArtifactId}-apiserver" dir="__rootArtifactId__-apiserver" name="${rootArtifactId}-apiserver">
      <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/main/java</directory>
          <includes>
            <include>**/*.java</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**/*.xml</include>
            <include>**/*.properties</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
    <module id="${rootArtifactId}-backserver" dir="__rootArtifactId__-backserver" name="${rootArtifactId}-backserver">
      <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/main/java</directory>
          <includes>
            <include>**/*.java</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**/*.xml</include>
            <include>**/*.html</include>
            <include>**/*.properties</include>
            <include>**/*.json</include>
          </includes>
        </fileSet>
        <fileSet encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**/*.jpg</include>
            <include>**/*.xlsx</include>
            <include>**/*.css</include>
            <include>**/*.TTF</include>
            <include>**/*.json</include>
            <include>**/*.js</include>
            <include>**/*.docx</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
    <module id="${rootArtifactId}-front" dir="__rootArtifactId__-front" name="${rootArtifactId}-front">
      <fileSets>
        <fileSet filtered="true" encoding="UTF-8">
          <directory>src/main/java</directory>
          <includes>
            <include>**/*.java</include>
          </includes>
        </fileSet>
        <fileSet encoding="UTF-8">
          <directory>src/main/java</directory>
          <includes>
            <include>**/*.gitkeep</include>
          </includes>
          <excludes>
            <exclude>.gitkeep</exclude>
          </excludes>
        </fileSet>
        <fileSet encoding="UTF-8">
          <directory>src/main/java</directory>
          <includes>
            <include>.gitkeep</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**/*.properties</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
          <directory>src/main/webapp</directory>
          <includes>
            <include>**/*.txt</include>
            <include>**/*.java</include>
            <include>**/*.xml</include>
            <include>**/*.html</include>
            <include>**/*.properties</include>
            <include>**/*.json</include>
          </includes>
        </fileSet>
        <fileSet encoding="UTF-8">
          <directory>src/main/webapp</directory>
          <includes>
            <include>**/*.jpg</include>
            <include>**/*.xlsx</include>
            <include>**/*.css</include>
            <include>**/*.swf</include>
            <include>**/*.gif</include>
            <include>**/*.svg</include>
            <include>**/*.ttf</include>
            <include>**/*.png</include>
            <include>**/*.js</include>
            <include>**/*.gitVersion/master</include>
            <include>**/*.eot</include>
            <include>**/*.swp</include>
            <include>**/*.woff</include>
            <include>**/*.gitkeep</include>
            <include>**/*.ico</include>
            <include>**/*.htc</include>
            <include>**/*.md</include>
            <include>**/*.json</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
    <module id="${rootArtifactId}-frontserver" dir="__rootArtifactId__-frontserver" name="${rootArtifactId}-frontserver">
      <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/main/java</directory>
          <includes>
            <include>**/*.java</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**/*.xml</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
    <module id="${rootArtifactId}-service" dir="__rootArtifactId__-service" name="${rootArtifactId}-service">
      <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/main/java</directory>
          <includes>
            <include>**/*.java</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
    <module id="${rootArtifactId}-shared" dir="__rootArtifactId__-shared" name="${rootArtifactId}-shared">
      <fileSets>
        <fileSet filtered="true" packaged="true" encoding="UTF-8">
          <directory>src/main/java</directory>
          <includes>
            <include>**/*.java</include>
          </includes>
        </fileSet>
        <fileSet filtered="true" encoding="UTF-8">
          <directory>src/main/resources</directory>
          <includes>
            <include>**/*.properties</include>
          </includes>
        </fileSet>
      </fileSets>
    </module>
  </modules>
</archetype-descriptor>
