#set ( $d = "$")
<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://activiti.org/bpmn20" id="review-definitions">
  <message id="annulationMessage" name="annulationMessage"></message>
  <message id="duplicationMessage" name="duplicationMessage"></message>
  <process id="process" name="Process ${artifactIdUpper} Gouvernement" isExecutable="true">
    <extensionElements>
      <activiti:executionListener event="Envois d'un email aux valideurs" delegateExpression="${d}{gouvBPMEnvoiEmailAgentsWithRolesDelegate}"></activiti:executionListener>
    </extensionElements>
    <startEvent id="start" activiti:formKey="wf:submitReviewTask"></startEvent>
    <serviceTask id="envoiMailUsagerServiceTask1" name="Envoi d'un email à l'usager" activiti:delegateExpression="${d}{gouvBPMEnvoiEmailUsagerDelegate}">
      <extensionElements>
        <activiti:field name="emailBodyTemplateCode">
          <activiti:string><![CDATA[MAIL_CREATION_DEMANDE_USAGER_CORPS]]></activiti:string>
        </activiti:field>
        <activiti:field name="emailSubjectTemplateCode">
          <activiti:string><![CDATA[MAIL_CREATION_DEMANDE_USAGER_OBJET]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow62" sourceRef="start" targetRef="exclusivegateway19"></sequenceFlow>
    <subProcess id="subprocess1" name="Sub Process">
      <startEvent id="startevent1" name="Start"></startEvent>
      <sequenceFlow id="flow92" sourceRef="startevent1" targetRef="prendreEnChargeTask"></sequenceFlow>
      <serviceTask id="servicetask5" name="Génération des fichiers remis par l'administration" activiti:delegateExpression="${d}{gouvBPMPdfDelegate}">
        <extensionElements>
          <activiti:field name="pdfTypeCodeExpr">
            <activiti:string><![CDATA[FICHIER]]></activiti:string>
          </activiti:field>
          <activiti:field name="meta">
            <activiti:string><![CDATA[BACK_FRONT_JUSTIFICATIF_DEMANDE]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <serviceTask id="creationDICTask" name="Création d'une demande d'informations complémentaires" activiti:delegateExpression="${d}{gouvBPMDemandeInfoComplDelegate}"></serviceTask>
      <sequenceFlow id="flow36" sourceRef="creationDICTask" targetRef="chgtEtatServiceTask3"></sequenceFlow>
      <serviceTask id="envoiMailUsagerServiceTask2" name="Envoi d'un email à l'usager" activiti:delegateExpression="${d}{gouvBPMEnvoiEmailUsagerDelegate}">
        <extensionElements>
          <activiti:field name="emailBodyTemplateCode">
            <activiti:string><![CDATA[MAIL_ACTION_DEMANDEIC_CORPS]]></activiti:string>
          </activiti:field>
          <activiti:field name="emailSubjectTemplateCode">
            <activiti:string><![CDATA[MAIL_ACTION_DEMANDEIC_OBJET]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <userTask id="traiterDemandeTask" name="Traiter la demande" activiti:assignee="${d}{MC_ASSIGNEE}" activiti:candidateGroups="TRAITEMENT">
        <extensionElements>
          <activiti:formProperty id="MC_TARGETSTATE" type="enum" required="true">
            <activiti:value id="ACCORDEE" name="Accorder"></activiti:value>
            <activiti:value id="REFUSEE" name="Refuser"></activiti:value>
            <activiti:value id="EN_ATTENTE_COMPL" name="Demander des informations complémentaires"></activiti:value>
          </activiti:formProperty>
          <activiti:formProperty id="MC_COMMENTAIRE_USAGER" type="string"></activiti:formProperty>
          <activiti:formProperty id="MC_CODE_MOTIF" type="string"></activiti:formProperty>
        </extensionElements>
      </userTask>
      <serviceTask id="chgtEtatServiceTask7" name="Passage à l'état public ACCORDEE" activiti:delegateExpression="${d}{gouvBPMStatusChangeDelegate}">
        <extensionElements>
          <activiti:field name="targetState">
            <activiti:string><![CDATA[ACCORDEE]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow82" sourceRef="chgtEtatServiceTask7" targetRef="exclusivegateway18"></sequenceFlow>
      <serviceTask id="servicetask6" name="Envoi d'un email à l'usager" activiti:delegateExpression="${d}{gouvBPMEnvoiEmailUsagerDelegate}">
        <extensionElements>
          <activiti:field name="emailBodyTemplateCode">
            <activiti:string><![CDATA[MAIL_ACTION_ACCORDEE_CORPS]]></activiti:string>
          </activiti:field>
          <activiti:field name="emailSubjectTemplateCode">
            <activiti:string><![CDATA[MAIL_ACTION_ACCORDEE_OBJET]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <serviceTask id="chgtEtatServiceTask6" name="Passage à l'état public REFUSEE" activiti:delegateExpression="${d}{gouvBPMStatusChangeDelegate}">
        <extensionElements>
          <activiti:field name="targetState">
            <activiti:string><![CDATA[REFUSEE]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow77" sourceRef="chgtEtatServiceTask6" targetRef="exclusivegateway9"></sequenceFlow>
      <serviceTask id="servicetask4" name="Envoi d'un email à l'usager" activiti:delegateExpression="${d}{gouvBPMEnvoiEmailUsagerDelegate}">
        <extensionElements>
          <activiti:field name="emailBodyTemplateCode">
            <activiti:string><![CDATA[MAIL_ACTION_REFUSER_CORPS]]></activiti:string>
          </activiti:field>
          <activiti:field name="emailSubjectTemplateCode">
            <activiti:string><![CDATA[MAIL_ACTION_REFUSER_OBJET]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <exclusiveGateway id="exclusivegateway9" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow78" sourceRef="exclusivegateway9" targetRef="servicetask4">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_DEMANDE_CANAL.equals('GUICHET_VIRTUEL')}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow79" sourceRef="exclusivegateway9" targetRef="servicetask18">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_DEMANDE_CANAL.equals('COURRIER') || MC_DEMANDE_CANAL.equals('GUICHET_PHYSIQUE')}]]></conditionExpression>
      </sequenceFlow>
      <serviceTask id="chgtEtatServiceTask1" name="Passage à l'état public &quot;En cours de traitement&quot;" activiti:delegateExpression="${d}{gouvBPMStatusChangeDelegate}">
        <extensionElements>
          <activiti:field name="targetState">
            <activiti:string><![CDATA[EN_COURS_TRAIT]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <serviceTask id="chgtEtatServiceTask3" name="Passage à l'état public EN_ATTENTE_COMPL" activiti:delegateExpression="${d}{gouvBPMStatusChangeDelegate}">
        <extensionElements>
          <activiti:field name="targetState">
            <activiti:string><![CDATA[EN_ATTENTE_COMPL]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow35" sourceRef="traiterDemandeTask" targetRef="creationDICTask">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_TARGETSTATE.equals('EN_ATTENTE_COMPL')}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow49" sourceRef="traiterDemandeTask" targetRef="enAttenteValidationData">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_TARGETSTATE.equals('REFUSEE')}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow50" sourceRef="traiterDemandeTask" targetRef="chgtEtatServiceTask7">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_TARGETSTATE.equals('ACCORDEE')}]]></conditionExpression>
      </sequenceFlow>
      <userTask id="depotICTask" name="Dépôt des pièces par l'usager ou l'agent" activiti:candidateGroups="TRAITEMENT">
        <extensionElements>
          <activiti:formProperty id="STAGE_PAR_USAGER_OU_AGENT" type="string" required="true">
            <activiti:value id="USAGER" name="USAGER"></activiti:value>
            <activiti:value id="AGENT" name="AGENT"></activiti:value>
          </activiti:formProperty>
        </extensionElements>
      </userTask>
      <sequenceFlow id="flow55" sourceRef="exclusivegateway22" targetRef="servicetask8">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_TARGETSTATE_ORIGINATOR_AGENT != MC_ASSIGNEE}]]></conditionExpression>
      </sequenceFlow>
      <serviceTask id="servicetask8" name="Envoi d'un email à l'agent affecté (template &quot;par agent&quot;)" activiti:delegateExpression="${d}{gouvBPMEnvoiEmailAgentAffecteDelegate}">
        <extensionElements>
          <activiti:field name="emailBodyTemplateCode">
            <activiti:string><![CDATA[MAIL_NOTIFICATION_REPONSE_IC_PAR_AGENT_CORPS]]></activiti:string>
          </activiti:field>
          <activiti:field name="emailSubjectTemplateCode">
            <activiti:string><![CDATA[MAIL_NOTIFICATION_REPONSE_IC_PAR_AGENT_OBJET]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow108" sourceRef="servicetask8" targetRef="chgtEtatServiceTask1"></sequenceFlow>
      <serviceTask id="servicetask9" name="Envoi d'un email à l'agent affecté (template &quot;par usager&quot;)" activiti:delegateExpression="${d}{gouvBPMEnvoiEmailAgentAffecteDelegate}">
        <extensionElements>
          <activiti:field name="emailBodyTemplateCode">
            <activiti:string><![CDATA[MAIL_NOTIFICATION_REPONSE_IC_PAR_USAGER_CORPS]]></activiti:string>
          </activiti:field>
          <activiti:field name="emailSubjectTemplateCode">
            <activiti:string><![CDATA[MAIL_NOTIFICATION_REPONSE_IC_PAR_USAGER_OBJET]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow112" sourceRef="servicetask9" targetRef="chgtEtatServiceTask1"></sequenceFlow>
      <sequenceFlow id="flow113" sourceRef="depotICTask" targetRef="servicetask9">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_TARGETSTATE_ORIGINATOR_USAGER != null}]]></conditionExpression>
      </sequenceFlow>
      <userTask id="prendreEnChargeTask" name="Prendre en charge" activiti:candidateGroups="TRAITEMENT"></userTask>
      <sequenceFlow id="flow93" sourceRef="prendreEnChargeTask" targetRef="chgtEtatServiceTask1"></sequenceFlow>
      <exclusiveGateway id="exclusivegateway13" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow120" sourceRef="chgtEtatServiceTask1" targetRef="exclusivegateway13"></sequenceFlow>
      <sequenceFlow id="flow121" sourceRef="exclusivegateway13" targetRef="traiterDemandeTask"></sequenceFlow>
      <endEvent id="endevent3" name="End"></endEvent>
      <sequenceFlow id="flow142" sourceRef="servicetask6" targetRef="servicetask5"></sequenceFlow>
      <sequenceFlow id="flow143" sourceRef="servicetask4" targetRef="servicetask5"></sequenceFlow>
      <sequenceFlow id="flow144" sourceRef="servicetask5" targetRef="servicetask19"></sequenceFlow>
      <serviceTask id="servicetask17" name="Envoi d'un email aux valideurs" activiti:delegateExpression="${d}{gouvBPMEnvoiEmailAgentsWithRolesDelegate}">
        <extensionElements>
          <activiti:field name="emailBodyTemplateCode">
            <activiti:string><![CDATA[MAIL_NOTIFICATION_ATTENTE_VALIDATION_CORPS]]></activiti:string>
          </activiti:field>
          <activiti:field name="emailSubjectTemplateCode">
            <activiti:string><![CDATA[MAIL_NOTIFICATION_ATTENTE_VALIDATION_OBJET]]></activiti:string>
          </activiti:field>
          <activiti:field name="roles">
            <activiti:string><![CDATA[VALIDATION]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <serviceTask id="enAttenteValidationData" name="Ajout du flag IS_EN_ATTENTE_VALIDATION" activiti:delegateExpression="${d}{gouvBPMUpdateDemandeDataDelegate}">
        <extensionElements>
          <activiti:field name="dataKey">
            <activiti:string><![CDATA[IS_EN_ATTENTE_VALIDATION]]></activiti:string>
          </activiti:field>
          <activiti:field name="dataValue">
            <activiti:string><![CDATA[1]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <userTask id="validationHierarchiqueTask1" name="Traiter la demande" activiti:candidateGroups="VALIDATION">
        <extensionElements>
          <activiti:formProperty id="MC_TARGETSTATE" type="enum" required="true">
            <activiti:value id="ACCORDEE" name="Accorder"></activiti:value>
            <activiti:value id="REFUSEE" name="Refuser"></activiti:value>
            <activiti:value id="EN_ATTENTE_COMPL" name="Demander des informations complémentaires"></activiti:value>
          </activiti:formProperty>
          <activiti:formProperty id="MC_COMMENTAIRE_USAGER" type="string"></activiti:formProperty>
          <activiti:formProperty id="MC_CODE_MOTIF" type="string"></activiti:formProperty>
          <activiti:formProperty id="${artifactIdUpper}_VALIDATION" type="boolean" required="true"></activiti:formProperty>
        </extensionElements>
      </userTask>
      <serviceTask id="deleteEnAttenteValidationData" name="Supression du flag IS_EN_ATTENTE_VALIDATION" activiti:delegateExpression="${d}{gouvBPMDeleteDemandeDataDelegate}">
        <extensionElements>
          <activiti:field name="dataKey">
            <activiti:string><![CDATA[IS_EN_ATTENTE_VALIDATION]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow146" sourceRef="enAttenteValidationData" targetRef="servicetask17"></sequenceFlow>
      <sequenceFlow id="flow147" sourceRef="servicetask17" targetRef="validationHierarchiqueTask1"></sequenceFlow>
      <sequenceFlow id="flow148" sourceRef="validationHierarchiqueTask1" targetRef="deleteEnAttenteValidationData"></sequenceFlow>
      <exclusiveGateway id="exclusivegateway16" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow149" sourceRef="deleteEnAttenteValidationData" targetRef="exclusivegateway16"></sequenceFlow>
      <sequenceFlow id="flow150" sourceRef="exclusivegateway16" targetRef="chgtEtatServiceTask1">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{${artifactIdUpper}_VALIDATION == false}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow151" sourceRef="exclusivegateway16" targetRef="exclusivegateway17">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{${artifactIdUpper}_VALIDATION == true}]]></conditionExpression>
      </sequenceFlow>
      <exclusiveGateway id="exclusivegateway17" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow152" sourceRef="exclusivegateway17" targetRef="chgtEtatServiceTask6">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_TARGETSTATE.equals('REFUSEE')}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow154" sourceRef="exclusivegateway17" targetRef="chgtEtatServiceTask7">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_TARGETSTATE.equals('ACCORDEE')}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow156" sourceRef="exclusivegateway17" targetRef="creationDICTask">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_TARGETSTATE.equals('EN_ATTENTE_COMPL')}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow157" sourceRef="exclusivegateway20" targetRef="envoiMailUsagerServiceTask2">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_DEMANDE_CANAL.equals('GUICHET_VIRTUEL')}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow158" sourceRef="envoiMailUsagerServiceTask2" targetRef="depotICTask"></sequenceFlow>
      <exclusiveGateway id="exclusivegateway18" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow159" sourceRef="exclusivegateway18" targetRef="servicetask6">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_DEMANDE_CANAL.equals('GUICHET_VIRTUEL')}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow160" sourceRef="exclusivegateway18" targetRef="servicetask18">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_DEMANDE_CANAL.equals('COURRIER') || MC_DEMANDE_CANAL.equals('GUICHET_PHYSIQUE')}]]></conditionExpression>
      </sequenceFlow>
      <serviceTask id="servicetask18" name="Génération du courrier" activiti:delegateExpression="${d}{gouvBPMPdfDelegate}">
        <extensionElements>
          <activiti:field name="pdfTypeCodeExpr">
            <activiti:string><![CDATA[COURRIER]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow161" sourceRef="servicetask18" targetRef="servicetask5"></sequenceFlow>
      <serviceTask id="servicetask19" name="Génération des fichiers internes" activiti:delegateExpression="${d}{gouvBPMDemandeRecapDelegate}"></serviceTask>
      <sequenceFlow id="flow164" sourceRef="servicetask19" targetRef="endevent3"></sequenceFlow>
      <exclusiveGateway id="exclusivegateway20" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow165" sourceRef="chgtEtatServiceTask3" targetRef="exclusivegateway20"></sequenceFlow>
      <serviceTask id="servicetask20" name="Génération du courrier" activiti:delegateExpression="${d}{gouvBPMPdfDelegate}">
        <extensionElements>
          <activiti:field name="pdfTypeCodeExpr">
            <activiti:string><![CDATA[COURRIER]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow166" sourceRef="exclusivegateway20" targetRef="servicetask20"></sequenceFlow>
      <sequenceFlow id="flow167" sourceRef="servicetask20" targetRef="depotICTask"></sequenceFlow>
      <exclusiveGateway id="exclusivegateway22" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow169" sourceRef="exclusivegateway22" targetRef="chgtEtatServiceTask1">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_TARGETSTATE_ORIGINATOR_AGENT == MC_ASSIGNEE}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow170" sourceRef="depotICTask" targetRef="exclusivegateway22"></sequenceFlow>
    </subProcess>
    <serviceTask id="annulationTask" name="annulation de la demande" activiti:delegateExpression="${d}{gouvBPMStatusChangeDelegate}">
      <extensionElements>
        <activiti:field name="targetState">
          <activiti:string><![CDATA[ANNULEE]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <endEvent id="terminateendeventAnnulation" name="terminateendeventAnnulation">
      <terminateEventDefinition></terminateEventDefinition>
    </endEvent>
    <endEvent id="endevent2" name="End"></endEvent>
    <sequenceFlow id="flow94" sourceRef="subprocess1" targetRef="endevent2"></sequenceFlow>
    <boundaryEvent id="boundarymessageAnnulation" name="boundarymessageAnnulation" attachedToRef="subprocess1" cancelActivity="true">
      <messageEventDefinition messageRef="annulationMessage"></messageEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="flow95" sourceRef="boundarymessageAnnulation" targetRef="annulationTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{!MC_CODE_MOTIF.equals('ANNULATION_DESINSCRIPTION')}]]></conditionExpression>
    </sequenceFlow>
    <serviceTask id="envoiEmailAnnulationTask" name="Envoi d'un email à l'usager pour annulation" activiti:delegateExpression="${d}{gouvBPMEnvoiEmailUsagerDelegate}">
      <extensionElements>
        <activiti:field name="emailBodyTemplateCode">
          <activiti:string><![CDATA[MAIL_CONFIRMATION_ACTION_ANNULER_CORPS]]></activiti:string>
        </activiti:field>
        <activiti:field name="emailSubjectTemplateCode">
          <activiti:string><![CDATA[MAIL_CONFIRMATION_ACTION_ANNULER_OBJET]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow96" sourceRef="annulationTask" targetRef="DeleteEnAttenteValidationData2"></sequenceFlow>
    <sequenceFlow id="flow97" sourceRef="envoiEmailAnnulationTask" targetRef="exclusivegateway15"></sequenceFlow>
    <startEvent id="duplicationMessageStartEvent" name="duplicationMessageStartEvent">
      <messageEventDefinition messageRef="duplicationMessage"></messageEventDefinition>
    </startEvent>
    <sequenceFlow id="flow98" sourceRef="duplicationMessageStartEvent" targetRef="subprocess1"></sequenceFlow>
    <exclusiveGateway id="exclusivegateway11" name="Exclusive Gateway"></exclusiveGateway>
    <sequenceFlow id="flow103" sourceRef="exclusivegateway11" targetRef="envoiEmailAnnulationTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_DEMANDE_CANAL.equals('GUICHET_VIRTUEL') && !MC_CODE_MOTIF.equals("ANNULATION_DESINSCRIPTION")}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow104" sourceRef="exclusivegateway11" targetRef="exclusivegateway15">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{(MC_DEMANDE_CANAL.equals('COURRIER') || MC_DEMANDE_CANAL.equals('GUICHET_PHYSIQUE')) && !MC_CODE_MOTIF.equals("ANNULATION_DESINSCRIPTION")}]]></conditionExpression>
    </sequenceFlow>
    <serviceTask id="DeleteEnAttenteValidationData2" name="Suppression du flag IS_EN_ATTENTE_VALIDATION" activiti:delegateExpression="${d}{gouvBPMDeleteDemandeDataDelegate}">
      <extensionElements>
        <activiti:field name="dataKey">
          <activiti:string><![CDATA[IS_EN_ATTENTE_VALIDATION]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow105" sourceRef="DeleteEnAttenteValidationData2" targetRef="exclusivegateway11"></sequenceFlow>
    <sequenceFlow id="flow137" sourceRef="envoiMailUsagerServiceTask1" targetRef="subprocess1"></sequenceFlow>
    <serviceTask id="servicetask14" name="Envoi d'un email aux agents qui ont le droit de traitement" activiti:delegateExpression="${d}{gouvBPMEnvoiEmailAgentsWithRolesDelegate}">
      <extensionElements>
        <activiti:field name="emailBodyTemplateCode">
          <activiti:string><![CDATA[MAIL_NOTIFICATION_ANNULATION_DEMANDE_PAR_USAGER_CORPS]]></activiti:string>
        </activiti:field>
        <activiti:field name="emailSubjectTemplateCode">
          <activiti:string><![CDATA[MAIL_NOTIFICATION_ANNULATION_DEMANDE_PAR_USAGER_OBJET]]></activiti:string>
        </activiti:field>
        <activiti:field name="roles">
          <activiti:string><![CDATA[TRAITEMENT]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow138" sourceRef="servicetask14" targetRef="terminateendeventAnnulation"></sequenceFlow>
    <exclusiveGateway id="exclusivegateway15" name="Exclusive Gateway"></exclusiveGateway>
    <sequenceFlow id="flow139" sourceRef="exclusivegateway15" targetRef="terminateendeventAnnulation">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_CODE_MOTIF.equals("ANNULATION_PAR_AGENT")}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow140" sourceRef="exclusivegateway15" targetRef="servicetask14">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_CODE_MOTIF.equals("ANNULATION_PAR_ENTREPRISE")}]]></conditionExpression>
    </sequenceFlow>
    <exclusiveGateway id="exclusivegateway19" name="Exclusive Gateway"></exclusiveGateway>
    <sequenceFlow id="flow162" sourceRef="exclusivegateway19" targetRef="envoiMailUsagerServiceTask1">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_DEMANDE_CANAL.equals('GUICHET_VIRTUEL')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow163" sourceRef="exclusivegateway19" targetRef="subprocess1"></sequenceFlow>
    <sequenceFlow id="flow168" sourceRef="exclusivegateway11" targetRef="terminateendeventAnnulation">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${d}{MC_CODE_MOTIF.equals("ANNULATION_DESINSCRIPTION")}]]></conditionExpression>
    </sequenceFlow>
    <textAnnotation id="textannotation9">
      <text>Statut cible ACCORDEE</text>
    </textAnnotation>
    <textAnnotation id="textannotation11">
      <text>Statut cible REFUSEE</text>
    </textAnnotation>
    <textAnnotation id="textannotation12">
      <text>Statut cible EN_ATTENTE_COMPL</text>
    </textAnnotation>
    <textAnnotation id="textannotation13">
      <text>Annulation d'une demande</text>
    </textAnnotation>
    <textAnnotation id="textannotation14">
      <text>Démarrage du process suite duplication (pas d'envoi d'emails)</text>
    </textAnnotation>
    <textAnnotation id="textannotation15">
      <text>Si usager courrier, aucun document n'est envoyé</text>
