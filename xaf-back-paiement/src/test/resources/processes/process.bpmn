<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:activiti="http://activiti.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" typeLanguage="http://www.w3.org/2001/XMLSchema" expressionLanguage="http://www.w3.org/1999/XPath" targetNamespace="http://activiti.org/bpmn20" id="review-definitions">
  <message id="annulationMessage" name="annulationMessage"></message>
  <message id="duplicationMessage" name="duplicationMessage"></message>
  <process id="process" name="Process CANDI Gouvernement" isExecutable="true">
    <startEvent id="start" activiti:formKey="wf:submitReviewTask"></startEvent>
    <serviceTask id="envoiMailUsagerServiceTask1" name="Envoi d'un email à l'usager" activiti:delegateExpression="${gouvBPMEnvoiEmailUsagerDelegate}">
      <extensionElements>
        <activiti:field name="emailBodyTemplateCode">
          <activiti:string><![CDATA[MAIL_CREATION_DEMANDE_USAGER_CORPS]]></activiti:string>
        </activiti:field>
        <activiti:field name="emailSubjectTemplateCode">
          <activiti:string><![CDATA[MAIL_CREATION_DEMANDE_USAGER_OBJET]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <serviceTask id="envoiMailAgentsServiceTask1" name="Envoi d'un email aux agents qui ont le droit de Traitement" activiti:delegateExpression="${gouvBPMEnvoiEmailAgentsWithRolesDelegate}">
      <extensionElements>
        <activiti:field name="emailBodyTemplateCode">
          <activiti:string><![CDATA[MAIL_CREATION_DEMANDE_AGENT_CORPS]]></activiti:string>
        </activiti:field>
        <activiti:field name="emailSubjectTemplateCode">
          <activiti:string><![CDATA[MAIL_CREATION_DEMANDE_AGENT_OBJET]]></activiti:string>
        </activiti:field>
        <activiti:field name="roles">
          <activiti:string><![CDATA[TRAITEMENT]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="exclusivegateway6" name="Exclusive Gateway"></exclusiveGateway>
    <sequenceFlow id="flow62" sourceRef="start" targetRef="exclusivegateway6"></sequenceFlow>
    <sequenceFlow id="flow63" sourceRef="exclusivegateway6" targetRef="envoiMailUsagerServiceTask1">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_DEMANDE_CANAL.equals('GUICHET_VIRTUEL')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow64" sourceRef="envoiMailUsagerServiceTask1" targetRef="envoiMailAgentsServiceTask1"></sequenceFlow>
    <sequenceFlow id="flow66" sourceRef="envoiMailAgentsServiceTask1" targetRef="subprocess1"></sequenceFlow>
    <subProcess id="subprocess1" name="Sub Process">
      <startEvent id="startevent1" name="Start"></startEvent>
      <sequenceFlow id="flow92" sourceRef="startevent1" targetRef="prendreEnChargeTask"></sequenceFlow>
      <exclusiveGateway id="exclusivegateway10" name="Exclusive Gateway"></exclusiveGateway>
      <userTask id="traiterDemandeTask" name="Traiter la demande" activiti:assignee="${MC_ASSIGNEE}" activiti:candidateGroups="TRAITEMENT">
        <extensionElements>
          <activiti:formProperty id="MC_TARGETSTATE" type="enum" required="true">
            <activiti:value id="VALIDEE" name="Valider"></activiti:value>
            <activiti:value id="REFUSEE" name="Refuser"></activiti:value>
            <activiti:value id="EN_ATTENTE_COMPL" name="Demander des informations complémentaires"></activiti:value>
          </activiti:formProperty>
          <activiti:formProperty id="MC_COMMENTAIRE_USAGER" type="string"></activiti:formProperty>
          <activiti:formProperty id="MC_CODE_MOTIF" type="string"></activiti:formProperty>
        </extensionElements>
      </userTask>
      <serviceTask id="chgtEtatServiceTask7" name="Passage à l'état public VALIDEE" activiti:delegateExpression="${gouvBPMStatusChangeDelegate}">
        <extensionElements>
          <activiti:field name="targetState">
            <activiti:string><![CDATA[VALIDEE]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow82" sourceRef="chgtEtatServiceTask7" targetRef="exclusivegateway10"></sequenceFlow>
      <serviceTask id="chgtEtatServiceTask6" name="Passage à l'état public REFUSEE" activiti:delegateExpression="${gouvBPMStatusChangeDelegate}">
        <extensionElements>
          <activiti:field name="targetState">
            <activiti:string><![CDATA[REFUSEE]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow77" sourceRef="chgtEtatServiceTask6" targetRef="exclusivegateway9"></sequenceFlow>
      <exclusiveGateway id="exclusivegateway2" name="Validee"></exclusiveGateway>
      <serviceTask id="servicetask4" name="Envoi d'un email à l'usager" activiti:delegateExpression="${gouvBPMEnvoiEmailUsagerDelegate}">
        <extensionElements>
          <activiti:field name="emailBodyTemplateCode">
            <activiti:string><![CDATA[MAIL_CONFIRMATION_ACTION_REFUSER_CORPS]]></activiti:string>
          </activiti:field>
          <activiti:field name="emailSubjectTemplateCode">
            <activiti:string><![CDATA[MAIL_CONFIRMATION_ACTION_REFUSER_OBJET]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow80" sourceRef="servicetask4" targetRef="endevent1"></sequenceFlow>
      <exclusiveGateway id="exclusivegateway9" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow78" sourceRef="exclusivegateway9" targetRef="servicetask4">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_DEMANDE_CANAL.equals('GUICHET_VIRTUEL')}]]></conditionExpression>
      </sequenceFlow>
      <serviceTask id="chgtEtatServiceTask1" name="Passage à l'état public &quot;En cours de traitement&quot;" activiti:delegateExpression="${gouvBPMStatusChangeDelegate}">
        <extensionElements>
          <activiti:field name="targetState">
            <activiti:string><![CDATA[EN_COURS_TRAIT]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <exclusiveGateway id="exclusivegateway3" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow49" sourceRef="exclusivegateway3" targetRef="chgtEtatServiceTask6">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_TARGETSTATE.equals('REFUSEE')}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow50" sourceRef="exclusivegateway3" targetRef="chgtEtatServiceTask7">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_TARGETSTATE.equals('VALIDEE')}]]></conditionExpression>
      </sequenceFlow>
      <endEvent id="endevent1" name="End"></endEvent>
      <userTask id="prendreEnChargeTask" name="Prendre en charge" activiti:candidateGroups="TRAITEMENT"></userTask>
      <sequenceFlow id="flow93" sourceRef="prendreEnChargeTask" targetRef="chgtEtatServiceTask1"></sequenceFlow>
      <exclusiveGateway id="exclusivegateway13" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow120" sourceRef="chgtEtatServiceTask1" targetRef="exclusivegateway13"></sequenceFlow>
      <sequenceFlow id="flow121" sourceRef="exclusivegateway13" targetRef="traiterDemandeTask"></sequenceFlow>
      <sequenceFlow id="flow122" sourceRef="traiterDemandeTask" targetRef="exclusivegateway2"></sequenceFlow>
      <sequenceFlow id="flow123" sourceRef="exclusivegateway2" targetRef="exclusivegateway3"></sequenceFlow>
      <serviceTask id="creationDICTask" name="Création d'une demande d'informations complémentaires" activiti:delegateExpression="${gouvBPMDemandeInfoComplDelegate}"></serviceTask>
      <sequenceFlow id="flow124" sourceRef="exclusivegateway3" targetRef="creationDICTask">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_TARGETSTATE.equals('EN_ATTENTE_COMPL')}]]></conditionExpression>
      </sequenceFlow>
      <serviceTask id="chgtEtatServiceTask3" name="Passage à l'état public EN_ATTENTE_COMPL" activiti:delegateExpression="${gouvBPMStatusChangeDelegate}">
        <extensionElements>
          <activiti:field name="targetState">
            <activiti:string><![CDATA[EN_ATTENTE_COMPL]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow125" sourceRef="creationDICTask" targetRef="chgtEtatServiceTask3"></sequenceFlow>
      <exclusiveGateway id="exclusivegateway14" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow126" sourceRef="chgtEtatServiceTask3" targetRef="exclusivegateway14"></sequenceFlow>
      <serviceTask id="servicetask8" name="Génération du courrier" activiti:delegateExpression="${gouvBPMPdfDelegate}"></serviceTask>
      <sequenceFlow id="flow127" sourceRef="exclusivegateway14" targetRef="servicetask8">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_DEMANDE_CANAL.equals('COURRIER') || MC_DEMANDE_CANAL.equals('GUICHET_PHYSIQUE')}]]></conditionExpression>
      </sequenceFlow>
      <serviceTask id="servicetask9" name="Envoi d'un email à l'usager" activiti:delegateExpression="${gouvBPMEnvoiEmailUsagerDelegate}">
        <extensionElements>
          <activiti:field name="emailBodyTemplateCode">
            <activiti:string><![CDATA[MAIL_CONFIRMATION_ACTION_DEMANDEIC_CORPS]]></activiti:string>
          </activiti:field>
          <activiti:field name="emailSubjectTemplateCode">
            <activiti:string><![CDATA[MAIL_CONFIRMATION_ACTION_DEMANDEIC_OBJET]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow128" sourceRef="exclusivegateway14" targetRef="servicetask9">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_DEMANDE_CANAL.equals('GUICHET_VIRTUEL')}]]></conditionExpression>
      </sequenceFlow>
      <exclusiveGateway id="exclusivegateway15" name="Exclusive Gateway"></exclusiveGateway>
      <sequenceFlow id="flow129" sourceRef="servicetask9" targetRef="exclusivegateway15"></sequenceFlow>
      <sequenceFlow id="flow130" sourceRef="servicetask8" targetRef="exclusivegateway15"></sequenceFlow>
      <userTask id="depotICTask" name="Dépôt des pièces par l'usager ou l'agent" activiti:candidateGroups="TRAITEMENT">
        <extensionElements>
          <activiti:formProperty id="STAGE_PAR_USAGER_OU_AGENT" type="string" required="true">
            <activiti:value id="USAGER" name="USAGER"></activiti:value>
            <activiti:value id="AGENT" name="AGENT"></activiti:value>
          </activiti:formProperty>
        </extensionElements>
      </userTask>
      <sequenceFlow id="flow131" sourceRef="exclusivegateway15" targetRef="depotICTask"></sequenceFlow>
      <serviceTask id="servicetask10" name="Envoi d'un email à l'agent affecté (template &quot;par usager&quot;)" activiti:delegateExpression="${gouvBPMEnvoiEmailAgentAffecteDelegate}">
        <extensionElements>
          <activiti:field name="emailBodyTemplateCode">
            <activiti:string><![CDATA[MAIL_NOTIFICATION_REPONSE_IC_PAR_USAGER_CORPS]]></activiti:string>
          </activiti:field>
          <activiti:field name="emailSubjectTemplateCode">
            <activiti:string><![CDATA[MAIL_NOTIFICATION_REPONSE_IC_PAR_USAGER_OBJET]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <serviceTask id="servicetask11" name="Envoi d'un email à l'agent affecté (template &quot;par agent&quot;)" activiti:delegateExpression="${gouvBPMEnvoiEmailAgentAffecteDelegate}">
        <extensionElements>
          <activiti:field name="emailBodyTemplateCode">
            <activiti:string><![CDATA[MAIL_NOTIFICATION_REPONSE_IC_PAR_AGENT_CORPS]]></activiti:string>
          </activiti:field>
          <activiti:field name="emailSubjectTemplateCode">
            <activiti:string><![CDATA[MAIL_NOTIFICATION_REPONSE_IC_PAR_AGENT_OBJET]]></activiti:string>
          </activiti:field>
        </extensionElements>
      </serviceTask>
      <sequenceFlow id="flow132" sourceRef="depotICTask" targetRef="servicetask10">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_TARGETSTATE_ORIGINATOR_USAGER != null}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow133" sourceRef="depotICTask" targetRef="servicetask11">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_TARGETSTATE_ORIGINATOR_AGENT != null}]]></conditionExpression>
      </sequenceFlow>
      <sequenceFlow id="flow134" sourceRef="servicetask10" targetRef="chgtEtatServiceTask1"></sequenceFlow>
      <sequenceFlow id="flow135" sourceRef="servicetask11" targetRef="chgtEtatServiceTask1"></sequenceFlow>
      <sequenceFlow id="flow136" sourceRef="exclusivegateway10" targetRef="endevent1"></sequenceFlow>
      <sequenceFlow id="flow137" sourceRef="exclusivegateway9" targetRef="endevent1">
        <conditionExpression xsi:type="tFormalExpression"><![CDATA[${!MC_DEMANDE_CANAL.equals('GUICHET_VIRTUEL')}]]></conditionExpression>
      </sequenceFlow>
      <textAnnotation id="textannotation16">
        <text>Statut cible EN_ATTENTE_COMPL</text>
      </textAnnotation>
    </subProcess>
    <serviceTask id="annulationTask" name="annulation de la demande" activiti:delegateExpression="${gouvBPMStatusChangeDelegate}">
      <extensionElements>
        <activiti:field name="targetState">
          <activiti:string><![CDATA[ANNULEE]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <endEvent id="terminateendeventAnnulation" name="terminateendeventAnnulation">
      <terminateEventDefinition></terminateEventDefinition>
    </endEvent>
    <endEvent id="endevent2" name="End"></endEvent>
    <sequenceFlow id="flow94" sourceRef="subprocess1" targetRef="endevent2"></sequenceFlow>
    <boundaryEvent id="boundarymessageAnnulation" name="boundarymessageAnnulation" attachedToRef="subprocess1" cancelActivity="true">
      <messageEventDefinition messageRef="annulationMessage"></messageEventDefinition>
    </boundaryEvent>
    <sequenceFlow id="flow95" sourceRef="boundarymessageAnnulation" targetRef="annulationTask"></sequenceFlow>
    <serviceTask id="envoiEmailAnnulationTask" name="Envoi d'un email à l'usager pour annulation" activiti:delegateExpression="${gouvBPMEnvoiEmailUsagerDelegate}">
      <extensionElements>
        <activiti:field name="emailBodyTemplateCode">
          <activiti:string><![CDATA[MAIL_CONFIRMATION_ACTION_ANNULER_CORPS]]></activiti:string>
        </activiti:field>
        <activiti:field name="emailSubjectTemplateCode">
          <activiti:string><![CDATA[MAIL_CONFIRMATION_ACTION_ANNULER_OBJET]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow96" sourceRef="annulationTask" targetRef="DeleteEnAttenteValidationData2"></sequenceFlow>
    <sequenceFlow id="flow97" sourceRef="envoiEmailAnnulationTask" targetRef="terminateendeventAnnulation"></sequenceFlow>
    <startEvent id="duplicationMessageStartEvent" name="duplicationMessageStartEvent">
      <messageEventDefinition messageRef="duplicationMessage"></messageEventDefinition>
    </startEvent>
    <sequenceFlow id="flow98" sourceRef="duplicationMessageStartEvent" targetRef="subprocess1"></sequenceFlow>
    <exclusiveGateway id="exclusivegateway11" name="Exclusive Gateway"></exclusiveGateway>
    <sequenceFlow id="flow103" sourceRef="exclusivegateway11" targetRef="envoiEmailAnnulationTask">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_DEMANDE_CANAL.equals('GUICHET_VIRTUEL')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow104" sourceRef="exclusivegateway11" targetRef="terminateendeventAnnulation">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_DEMANDE_CANAL.equals('COURRIER') || MC_DEMANDE_CANAL.equals('GUICHET_PHYSIQUE')}]]></conditionExpression>
    </sequenceFlow>
    <serviceTask id="DeleteEnAttenteValidationData2" name="Suppression du flag IS_EN_ATTENTE_VALIDATION" activiti:delegateExpression="${gouvBPMDeleteDemandeDataDelegate}">
      <extensionElements>
        <activiti:field name="dataKey">
          <activiti:string><![CDATA[IS_EN_ATTENTE_VALIDATION]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow105" sourceRef="DeleteEnAttenteValidationData2" targetRef="exclusivegateway11"></sequenceFlow>
    <serviceTask id="servicetask12" name="Génération du courrier" activiti:delegateExpression="${gouvBPMPdfDelegate}"></serviceTask>
    <sequenceFlow id="flow138" sourceRef="exclusivegateway6" targetRef="servicetask12">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_DEMANDE_CANAL.equals('COURRIER') || MC_DEMANDE_CANAL.equals('GUICHET_PHYSIQUE')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow139" sourceRef="servicetask12" targetRef="envoiMailAgentsServiceTask1"></sequenceFlow>
    <boundaryEvent id="boundarytimer1" name="Timer" attachedToRef="subprocess1" cancelActivity="false">
      <documentation>Pour tester toutes les minutes : 0 * * ? * * *
Pour tous les jours à 1h du matin : 0 0 1 ? * * *</documentation>
      <timerEventDefinition>
        <timeCycle>0 0 1 ? * * *</timeCycle>
      </timerEventDefinition>
    </boundaryEvent>
    <serviceTask id="servicetask13" name="Vérifier périodiquement si la demande a expiré" activiti:delegateExpression="${gouvBPMExpirationCheckDelegate}">
      <extensionElements>
        <activiti:field name="numberOfDays">
          <activiti:string><![CDATA[365]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow140" sourceRef="boundarytimer1" targetRef="servicetask13"></sequenceFlow>
    <exclusiveGateway id="exclusivegateway16" name="Exclusive Gateway"></exclusiveGateway>
    <sequenceFlow id="flow142" sourceRef="servicetask13" targetRef="exclusivegateway16"></sequenceFlow>
    <sequenceFlow id="flow143" sourceRef="exclusivegateway16" targetRef="endevent3">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${!MC_EXPIRED}]]></conditionExpression>
    </sequenceFlow>
    <serviceTask id="servicetask14" name="Passage à l'état public EXPIREE" activiti:delegateExpression="${gouvBPMStatusChangeDelegate}">
      <extensionElements>
        <activiti:field name="targetState">
          <activiti:string><![CDATA[EXPIREE]]></activiti:string>
        </activiti:field>
        <activiti:field name="codeMotif">
          <activiti:string><![CDATA[DEMANDE_EXPIREE]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="exclusivegateway17" name="Exclusive Gateway"></exclusiveGateway>
    <serviceTask id="servicetask15" name="Envoi d'un email à l'usager pour expiration" activiti:delegateExpression="${gouvBPMEnvoiEmailUsagerDelegate}">
      <extensionElements>
        <activiti:field name="emailBodyTemplateCode">
          <activiti:string><![CDATA[MAIL_NOTIFICATION_EXPIRATION_POUR_USAGER_CORPS]]></activiti:string>
        </activiti:field>
        <activiti:field name="emailSubjectTemplateCode">
          <activiti:string><![CDATA[MAIL_NOTIFICATION_EXPIRATION_POUR_USAGER_OBJET]]></activiti:string>
        </activiti:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="flow144" sourceRef="exclusivegateway16" targetRef="servicetask14">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_EXPIRED}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow145" sourceRef="servicetask14" targetRef="exclusivegateway17"></sequenceFlow>
    <sequenceFlow id="flow146" sourceRef="exclusivegateway17" targetRef="terminateendeventAnnulation">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${!MC_DEMANDE_CANAL.equals('GUICHET_VIRTUEL')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow147" sourceRef="exclusivegateway17" targetRef="servicetask15">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${MC_DEMANDE_CANAL.equals('GUICHET_VIRTUEL')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow148" sourceRef="servicetask15" targetRef="terminateendeventAnnulation"></sequenceFlow>
    <endEvent id="endevent3" name="End"></endEvent>
    <textAnnotation id="textannotation9">
      <text>Statut cible VALIDEE</text>
    </textAnnotation>
    <textAnnotation id="textannotation11">
      <text>Statut cible REFUSEE</text>
    </textAnnotation>
    <textAnnotation id="textannotation13">
      <text>Annulation d'une demande</text>
    </textAnnotation>
    <textAnnotation id="textannotation14">
      <text>Démarrage du process suite duplication (pas d'envoi d'emails)</text>
    </textAnnotation>
    <textAnnotation id="textannotation15">
      <text>Si usager courrier, aucun document n'est envoyé</text>
    </textAnnotation>
  </process>
