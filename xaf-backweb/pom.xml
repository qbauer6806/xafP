<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>mc.gouv.xaf</groupId>
        <artifactId>xaf</artifactId>
        <version>11.1.0</version>
    </parent>

    <artifactId>xaf-backweb</artifactId>

	<properties>
		<maven.compiler.source>11</maven.compiler.source>
		<maven.compiler.target>11</maven.compiler.target>
		<logon-apiclient.version>5.2.2</logon-apiclient.version>
	</properties>

    <dependencies>
        <dependency>
            <groupId>mc.gouv.xaf</groupId>
            <artifactId>xaf-back</artifactId>
            <version>11.1.0</version>
        </dependency>

        <dependency>
            <groupId>mc.gouv.xboot</groupId>
            <artifactId>xboot-spring-starter-web</artifactId>
            <exclusions>
		        <!-- Exclude the Jetty-9 specific dependencies -->
		        <exclusion>
		            <groupId>org.eclipse.jetty.websocket</groupId>
		            <artifactId>websocket-server</artifactId>
		        </exclusion>
		        <exclusion>
		            <groupId>org.eclipse.jetty.websocket</groupId>
		            <artifactId>javax-websocket-server-impl</artifactId>
		        </exclusion>
		        <exclusion>
					<groupId>org.eclipse.jetty</groupId>
					<artifactId>jetty-jndi</artifactId>
				</exclusion>
		    </exclusions>
        </dependency>

        <!-- Web JS and CSS dependencies -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>Eonasdan-bootstrap-datetimepicker</artifactId>
            <version>4.17.47</version>
        </dependency>
        <dependency>
    		<groupId>org.webjars</groupId>
    		<artifactId>Magnific-Popup</artifactId>
    		<version>1.1.0</version>
		</dependency>
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox-tools</artifactId>
			<version>2.0.25</version>
		</dependency>
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>jbig2-imageio</artifactId>
			<version>3.0.2</version>
		</dependency>

        <dependency>
            <groupId>mc.gouv.logon</groupId>
            <artifactId>logon-caching</artifactId>
            <version>${logon-apiclient.version}</version>
        </dependency>

        <dependency>
            <groupId>mc.gouv.logon</groupId>
            <artifactId>logon-apiclient</artifactId>
            <version>${logon-apiclient.version}</version>
        </dependency>


	</dependencies>

</project>

