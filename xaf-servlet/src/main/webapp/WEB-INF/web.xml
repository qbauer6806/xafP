        <filter-class>mc.gouv.xaf.servlet.filter.IPFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>IPFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    
    <context-param>
        <param-name>DemarcheID</param-name>
        <param-value>HAB</param-value>
    </context-param>

    <context-param>
        <param-name>ContainerID</param-name>
        <param-value>ROOT</param-value>
    </context-param>
    
    <error-page>
        <exception-type>mc.gouv.xapi.error.exception.WebException</exception-type>
        <location>/erreur</location>
    </error-page>
    
    <servlet>
        <servlet-name>ErreurServlet</servlet-name>
