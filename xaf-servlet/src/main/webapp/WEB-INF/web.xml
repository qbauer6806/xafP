    </servlet-mapping>

    <servlet>
        <servlet-name>DocHolderCategoriesServlet</servlet-name>
        <servlet-class>mc.gouv.xaf.servlet.DocHolderCategoriesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DocHolderCategoriesServlet</servlet-name>
        <url-pattern>/doc-holder/categories</url-pattern>
